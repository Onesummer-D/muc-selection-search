{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Onesummer-D/muc-selection-search/schemas/extraction_bundle.v1.schema.json",
  "title": "Extraction Bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "notice_id", "extractor_version", "records", "processing_status", "processed_at"],
  "properties": {
    "schema_version": {"const": "extraction_bundle.v1"},
    "notice_id": {"type": "string", "minLength": 1},
    "extractor_version": {"type": "string", "minLength": 1},
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["record_key", "cohort", "grade", "education", "college", "major", "city", "position_or_unit", "review_status", "confidence", "evidence"],
        "properties": {
          "record_key": {"type": "string", "minLength": 1},
          "cohort": {"type": ["string", "null"]},
          "grade": {"type": ["string", "null"]},
          "education": {"type": ["string", "null"]},
          "college": {"type": ["string", "null"]},
          "major": {"type": ["string", "null"]},
          "city": {"type": ["string", "null"]},
          "position_or_unit": {"type": ["string", "null"]},
          "review_status": {"enum": ["pending", "processed", "review_required", "failed"]},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["field", "text", "method", "asset_id", "bbox"],
              "properties": {
                "field": {"enum": ["cohort", "grade", "education", "college", "major", "city", "position_or_unit"]},
                "text": {"type": "string", "minLength": 1},
                "method": {"enum": ["html_rule", "ocr_rule", "multimodal", "manual"]},
                "asset_id": {"type": ["string", "null"]},
                "bbox": {
                  "oneOf": [
                    {"type": "null"},
                    {"type": "array", "items": {"type": "number"}, "minItems": 4, "maxItems": 4}
                  ]
                }
              }
            }
          }
        }
      }
    },
    "processing_status": {"enum": ["pending", "processed", "review_required", "failed"]},
    "failure_reason": {"type": ["string", "null"]},
    "processed_at": {"type": "string", "format": "date-time"}
  }
}

